{
  "name": "fabiotobon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrar": "node --env-file-if-exists=.env --import tsx scripts/migrar.ts",
    "db:semilla-demo": "node --env-file-if-exists=.env --import tsx scripts/semilla-demo.ts",
    "db:tipos": "node --env-file-if-exists=.env node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --out-file src/lib/db/tipos.ts --exclude-pattern schema_migrations",
    "usuario:crear": "node --env-file-if-exists=.env --import tsx scripts/usuario-crear.ts",
    "usuario:contrasena": "node --env-file-if-exists=.env --import tsx scripts/usuario-contrasena.ts",
    "usuario:reiniciar-2fa": "node --env-file-if-exists=.env --import tsx scripts/usuario-reiniciar-2fa.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "better-auth": "1.7.5",
    "date-fns": "4.4.0",
    "kysely": "0.29.6",
    "libphonenumber-js": "1.13.13",
    "next": "16.3.8",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "kysely-codegen": "0.20.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@11.6.2"
}
