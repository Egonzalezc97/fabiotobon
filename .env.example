# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# Entorno de la aplicación: development | production
APP_ENV=development

# PostgreSQL (los valores coinciden con docker-compose.yml, solo para desarrollo local)
DATABASE_URL=postgres://fabiotobon:fabiotobon_local@localhost:5433/fabiotobon
# Base para pruebas automatizadas. Su nombre debe terminar en _test: las pruebas la borran.
DATABASE_URL_TEST=postgres://fabiotobon:fabiotobon_local@localhost:5433/fabiotobon_test

# Better Auth. Genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
